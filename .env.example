NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/temur_pubgm

# JWT
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie
COOKIE_SECRET=replace_me_cookie
COOKIE_DOMAIN=localhost

# CORS
CLIENT_URL=http://localhost:5173

# Shared secret between server and bot (must match bot's BOT_SHARED_SECRET)
BOT_SHARED_SECRET=replace_me_bot_secret

# Bot's internal HTTP server (sponsor check + broadcast send). Must match bot's host:port.
BOT_INTERNAL_URL=http://127.0.0.1:5300
